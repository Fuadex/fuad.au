# Rotation app — ignore rules (nested; paths relative to rotation/)

# large local datasets — never commit
# (.gitignore has NO inline comments — patterns must stand alone on their own line)
*.parquet
*.zip
# compressed local archives + any DB unpacked from them — PRIVATE, local-only
*.gz
*.sqlite
*.sqlite3
*.db
archive.zip
archive_genius.zip
# personal Spotify exports — PRIVATE (contain IP addresses + liked songs), never commit
my_spotify_data*.zip
Spotify Extended Streaming History/
Spotify Account Data/
spotify-sync.log
gigs-local.json
# scratch logs from background enrichment runs
*-run.log

# local notes
CSV-OVERRIDES.md
IDEAS.md

# generated by build-data.js / sync-live.js — built in CI, deployed as a Pages
# artifact, never committed (see ROADMAP A2). world-map.js is static and STAYS committed.
music-core.js
music-rest.js
day-series.js
day-hours.js
pulse.js
genius-mood-lazy.js
genius-about-lazy.js
genius-themes-lazy.js
filter-index.js
live-data.js
search-index.js
media-index.js
track-audio.js
track-previews.js
shelves-unplayed.js
artist-flow.js
artist-detail.js
calendar.js
calendar-detail.js
geo-detail.js
tm-tour-lazy.js
album-about-lazy.js
album-alias.js
variant-of.js
album-absorb.js
liked-meta.js
album-extras.js
artist-days.js
mb-lineup.js

# llm-about shards + theme index — CI artifacts from shard-about.js (which STAYS committed).
# llm-about.js itself remains the committed source of truth; only the split output is ignored.
about/
genealogy.js

# Backup copies of data files. These carry stale snapshots of the very files that
# receive privacy fixes, so an accidental `git add -A` would re-publish scrubbed data.
*.bak
*.bak-*
*.bak.*
